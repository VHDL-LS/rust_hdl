// The VHDL syntax as actually modelled by `vhdl_syntax`, in ungrammar form.
//
// This is the input to `cargo xtask codegen`, which generates
// `vhdl_syntax/src/syntax/generated/` from it. `vhdl-08.ungram` next to this
// file is the unmodified LRM grammar, kept for comparison.
//
// Legend:
//
// //            -- comment
// // § X.Y.Z    -- LRM Chapter of the production
// 'ident'       -- keyword or punct token (terminal)
// '#ident'      -- generic token (terminal)
// A B           -- sequence
// A | B         -- alternation
// A*            -- zero or more repetition
// A?            -- zero or one repetition
// (A)           -- same as A
// label:A       -- named occurrence (renames the generated accessor)
//==============================================================================
// § 11: Concurrent Statements
//==============================================================================
DeclarationStatementSeparator =
  'begin'

BlockHeader =
  generic_part:(GenericClause generic_map:(GenericMapAspect ';')?)?
  port_part:(PortClause port_map:(PortMapAspect ';')?)?

BlockStatement =
  Label
  block_preamble:('block' parenthesized_expression:('(' Expression ')')? 'is'?)
  BlockHeader
  Declarations
  DeclarationStatementSeparator
  ConcurrentStatements
  block_epilogue:('end' 'block' '#identifier'? ';')

CaseGenerateAlternative =
  'when' Label? Choices '=>' GenerateStatementBody

CaseGenerateStatement =
  Label
  case_generate_preamble:('case' Expression 'generate')
  CaseGenerateAlternative*
  generate_epilogue:('end' 'generate' '#identifier'? ';')

ComponentInstantiationStatement =
  Label InstantiatedUnit GenericMapAspect? PortMapAspect? ';'

// A procedure with zero arguments (`proc_call: foo;`) and a component instantiation (`inst: cmp;`) without generic / port
// maps are indistinguishable.
ConcurrentProcedureCallOrComponentInstantiationStatement =
  Label? 'postponed'? Name ';'

ConcurrentAssertionStatement =
  Label? 'postponed'? Assertion ';'

ConcurrentSimpleSignalAssignment =
  Label? 'postponed'? Target '<=' 'guarded'? DelayMechanism? Waveform ';'

ConcurrentConditionalSignalAssignment =
  Label?
  'postponed'?
  Target
  '<='
  'guarded'?
  DelayMechanism?
  ConditionalWaveforms
  ';'

ConcurrentSelectedSignalAssignment =
  Label?
  'postponed'?
  selected_assignment_preamble:('with' Expression 'select' '?'?)
  Target
  '<='
  'guarded'?
  DelayMechanism?
  SelectedWaveforms
  ';'

ConcurrentStatement =
  BlockStatement
| ProcessStatement
| ConcurrentAssertionStatement
| ComponentInstantiationStatement
| ConcurrentSelectedSignalAssignment
| ConcurrentConditionalSignalAssignment
| ConcurrentSimpleSignalAssignment
| ConcurrentProcedureCallOrComponentInstantiationStatement
| ForGenerateStatement
| IfGenerateStatement
| CaseGenerateStatement

// | PslDirective  -- add here if PSL is supported
ConcurrentStatements =
  ConcurrentStatement*

ForGenerateStatement =
  Label
  for_generate_preamble:('for' ParameterSpecification 'generate')
  GenerateStatementBody
  generate_epilogue:('end' 'generate' '#identifier'? ';')

GenerateStatementBody =
  generate_body_declarations:(Declarations? DeclarationStatementSeparator)?
  ConcurrentStatements
  generate_body_epilogue:('end' '#identifier'? ';')?

IfGenerateStatement =
  Label
  if_generate_if:('if' Label? Expression 'generate' GenerateStatementBody)
  if_generate_elsif:('elsif' Label? Expression 'generate' GenerateStatementBody)*
  if_generate_else:('else' Label? 'generate' GenerateStatementBody)?
  generate_epilogue:('end' 'generate' '#identifier'? ';')

InstantiatedUnit =
  instantiated_component:('component'? Name)
  // LRM has `"entity" name [ "(" identifier ")" ]`. The `(identifier)`
  // architecture-disambiguation is absorbed as a `ParenthesizedName` tail.
| instantiated_entity:('entity' Name)
| instantiated_configuration:('configuration' Name)

AllSensitivityList =
  'all'

SensitivityList =
  Name* ','*

ProcessSensitivityList =
  AllSensitivityList | SensitivityList

ProcessStatement =
  Label?
  process_preamble:(
    'postponed'?
    'process'
    parenthesized_process_sensitivity_list:('(' ProcessSensitivityList ')')?
    'is'?
  )
  Declarations
  DeclarationStatementSeparator
  SequentialStatements
  process_epilogue:('end' 'postponed'? 'process' '#identifier'? ';')

//==============================================================================
// § 6: Declarations
//==============================================================================
Declaration =
  SubprogramDeclaration
| SubprogramBody
| SubprogramInstantiationDeclaration
| PackageDeclaration
| PackageBodyDeclaration
| PackageInstantiationDeclaration
| TypeDeclaration
| SubtypeDeclaration
| FileDeclaration
| AliasDeclaration
| ComponentDeclaration
| AttributeDeclaration
| AttributeSpecification
| ConfigurationSpecification
| DisconnectionSpecification
| UseClauseDeclaration
| GroupTemplateDeclaration
| GroupDeclaration
| ConstantDeclaration
| SignalDeclaration
| VariableDeclaration

// | PslPropertyDeclaration  -- add here if PSL is supported
// | PslSequenceDeclaration  -- add here if PSL is supported
// | PslClockDeclaration     -- add here if PSL is supported
PackageDeclaration =
  Package

PackageInstantiationDeclaration =
  PackageInstantiation

PackageBodyDeclaration =
  PackageBody

UseClauseDeclaration =
  UseClause

// LRM:
//   actual_part       ::= actual_designator | name "(" actual_designator ")"
//                       | type_mark "(" actual_designator ")"
//   actual_designator ::= [inertial] expression | subtype_indication | open
//
// Disambiguation between `Expression` and `SubtypeIndication` is done at
// parse time by lookahead: the only syntactic discriminator is a second
// name following the first (the resolution_function_name + type_mark
// pattern, or the `(element_resolution)` + type_mark pattern). The wrapped
// `name "(" actual_designator ")"` forms collapse into `Expression`
// because `Name` accepts a `ParenthesizedName` tail; analysis disambiguates
// type conversions / resolution functions later.
ActualPartExpression =
  Expression

ActualPartSubtypeIndication =
  SubtypeIndication

ActualPartOpen =
  'open'

ActualPartBody =
  ActualPartExpression | ActualPartSubtypeIndication | ActualPartOpen

ActualPart =
  'inertial'? ActualPartBody

AliasDeclaration =
  'alias' AliasDesignator alias_subtype:(':' SubtypeIndication)? 'is' Name Signature? ';'

AliasDesignator =
  '#identifier' | '#character_literal' | '#string_literal'

AssociationElement =
  formal:(FormalPart '=>')?
  ActualPart

AssociationList =
  AssociationElement* ','*

AttributeDeclaration =
  'attribute' '#identifier' ':' Name ';'

ComponentDeclaration =
  component_declaration_preamble:('component' name:'#identifier' 'is'?)
  GenericClause?
  PortClause?
  component_declaration_epilogue:('end' 'component' '#identifier'? ';')

ConstantDeclaration =
  'constant'
  IdentifierList
  ':'
  SubtypeIndication
  initial_value:(':=' Expression)?
  ';'

ResolutionIndicationElementResolution =
  ResolutionIndication

RecordResolutionElementResolution =
  RecordResolution?

ElementResolution =
  ResolutionIndicationElementResolution | RecordResolutionElementResolution

EntityClassEntry =
  EntityClass '<>'?

EntityClassEntryList =
  EntityClassEntry* ','*

FileDeclaration =
  'file' IdentifierList ':' SubtypeIndication FileOpenInformation? ';'

FileOpenInformation =
  file_open_kind:('open' Expression)? 'is' Expression

// LRM has `name | name "(" formal_designator ")" | type_mark "(" formal_designator ")"`.
// The `name "(" ... ")"` and `type_mark "(" ... ")"` forms reduce to a `Name`
// with a `ParenthesizedName` tail, so a plain `Name` covers all cases.
FormalPart =
  Name

FullTypeDeclaration =
  'type' '#identifier' 'is' TypeDefinition ';'

GenericClause =
  generic_clause_preamble:('generic' '(')
  InterfaceList?
  generic_clause_epilogue:(')' ';')

GenericMapAspect =
  'generic' 'map' '(' AssociationList ')'

// LRM has `"group" identifier ":" name "(" group_constituent_list ")" ";"`.
// The `(group_constituent_list)` is absorbed as a `ParenthesizedName` tail on
// the preceding `Name`, so no explicit list/parens are needed here.
GroupDeclaration =
  'group' '#identifier' ':' Name ';'

GroupTemplateDeclaration =
  'group' '#identifier' 'is' '(' EntityClassEntryList ')' ';'

InterfaceDeclaration =
  InterfaceObjectDeclaration
| InterfaceFileDeclaration
| InterfaceIncompleteTypeDeclaration
| InterfaceSubprogramDeclaration
| InterfacePackageDeclaration

InterfaceFileDeclaration =
  'file' IdentifierList ':' SubtypeIndication

InterfaceFunctionSpecification =
  purity:('pure' | 'impure')?
  'function'
  Designator
  parameter_list:('parameter'? parenthesized_interface_list:('(' InterfaceList ')'))?
  'return'
  Name

InterfaceIncompleteTypeDeclaration =
  'type' '#identifier'

InterfaceList =
  InterfaceDeclaration* ';'*

// A non-file interface object (constant/signal/variable)
InterfaceObjectDeclaration =
  InterfaceObjectClass?
  IdentifierList
  ':'
  Mode?
  SubtypeIndication
  'bus'?
  initial_value:(':=' Expression)?

InterfaceObjectClass =
  'constant' | 'signal' | 'variable'

InterfacePackageDeclaration =
  interface_package_declaration_preamble:('package' '#identifier' 'is')
  'new'
  Name
  InterfacePackageGenericMapAspect

InterfacePackageGenericMapAspect =
  'generic' 'map' '(' InterfacePackageGenericMapAspectInner ')'

InterfacePackageGenericMapAspectBox =
  '<>'

InterfacePackageGenericMapAspectDefault =
  'default'

InterfacePackageGenericMapAspectAssociations =
  AssociationList

InterfacePackageGenericMapAspectInner =
  InterfacePackageGenericMapAspectBox
| InterfacePackageGenericMapAspectDefault
| InterfacePackageGenericMapAspectAssociations

InterfaceProcedureSpecification =
  'procedure'
  Designator
  parameter_list:('parameter'? parenthesized_interface_list:('(' InterfaceList ')'))?

InterfaceSubprogramDeclaration =
  InterfaceSubprogramSpecification subprogram_default:('is' InterfaceSubprogramDefault)?

InterfaceSubprogramDefaultName =
  Name

InterfaceSubprogramDefaultBox =
  '<>'

InterfaceSubprogramDefault =
  InterfaceSubprogramDefaultName | InterfaceSubprogramDefaultBox

InterfaceSubprogramSpecification =
  InterfaceProcedureSpecification | InterfaceFunctionSpecification

Mode =
  'in' | 'out' | 'inout' | 'buffer' | 'linkage'

PortClause =
  port_clause_preamble:('port' '(')
  InterfaceList?
  port_clause_epilogue:(')' ';')

PortMapAspect =
  'port' 'map' '(' AssociationList ')'

RecordElementResolution =
  name:'#identifier' ResolutionIndication

RecordResolution =
  RecordElementResolution* ','*

NameResolutionIndication =
  Name

// TODO: Is this required? (Could potentially be replaced by Element Resolution)
ElementResolutionResolutionIndication =
  ElementResolution

ResolutionIndication =
  NameResolutionIndication
| parenthesized_element_resolution:('(' ElementResolutionResolutionIndication ')')

SignalDeclaration =
  'signal'
  IdentifierList
  ':'
  SubtypeIndication
  SignalKind?
  initial_value:(':=' Expression)?
  ';'

SignalKind =
  'register' | 'bus'

SubtypeDeclaration =
  'subtype' '#identifier' 'is' SubtypeIndication ';'

// LRM has `[resolution_indication] type_mark [constraint]`. Here `type_mark`
// becomes `Name`, and constraints (range/index/record) are absorbed as
// `NameTail` items, so no explicit `Constraint` slot is needed.
SubtypeIndication =
  ResolutionIndication? Name

TypeDeclaration =
  FullTypeDeclaration | IncompleteTypeDeclaration

TypeDefinition =
  ScalarTypeDefinition
| CompositeTypeDefinition
| AccessTypeDefinition
| FileTypeDefinition
| ProtectedTypeDefinition

VariableDeclaration =
  'shared'?
  'variable'
  IdentifierList
  ':'
  SubtypeIndication
  initial_value:(':=' Expression)?
  ';'

Declarations =
  Declaration*

//==============================================================================
// § 3: Design entities and configuration
//==============================================================================
ArchitectureBody =
  architecture_preamble:('architecture' name:'#identifier' 'of' entity_name:Name 'is')
  Declarations
  DeclarationStatementSeparator
  ConcurrentStatements
  architecture_epilogue:('end' 'architecture'? '#identifier'? ';')

BlockConfigurationItem =
  BlockConfiguration

ConfigurationItem =
  BlockConfigurationItem | ComponentConfiguration

BlockConfiguration =
  block_configuration_preamble:('for' Name)
  UseClause*
  ConfigurationItem*
  block_configuration_epilogue:('end' 'for' ';')

ComponentConfiguration =
  component_configuration_preamble:('for' ComponentSpecification)
  binding:(BindingIndication ';')?
  verification_unit_binding:(VerificationUnitBindingIndication ';')*
  BlockConfiguration?
  component_configuration_epilogue:('end' 'for' ';')

ConfigurationDeclaration =
  configuration_declaration_preamble:('configuration' name:'#identifier' 'of' entity_name:Name 'is')
  Declarations
  verification_unit_binding:(VerificationUnitBindingIndication ';')*
  BlockConfiguration
  configuration_declaration_epilogue:('end' 'configuration'? '#identifier'? ';')

EntityDeclaration =
  entity_declaration_preamble:('entity' name:'#identifier' 'is')
  EntityHeader
  Declarations
  entity_statement_part:(DeclarationStatementSeparator ConcurrentStatements)?
  entity_declaration_epilogue:('end' 'entity'? '#identifier'? ';')

EntityHeader =
  GenericClause? PortClause?

//==============================================================================
// § 13: Design Units
//==============================================================================
ContextClause =
  ContextItem*

ContextDeclaration =
  context_declaration_preamble:('context' name:'#identifier' 'is')
  ContextClause
  context_declaration_epilogue:('end' 'context'? '#identifier'? ';')

UseClauseContextItem =
  UseClause

ContextReference =
  'context' NameList? ';'

ContextItem =
  LibraryClause | UseClauseContextItem | ContextReference

DesignFile =
  DesignUnit* '#eof'

DesignUnit =
  ContextClause LibraryUnit

LibraryClause =
  'library' IdentifierList ';'

LibraryUnit =
  PrimaryUnit | SecondaryUnit

PrimaryUnitPackageDeclaration =
  Package

PackageInstantiationDeclarationPrimaryUnit =
  PackageInstantiation

PrimaryUnit =
  EntityDeclaration
| ConfigurationDeclaration
| PrimaryUnitPackageDeclaration
| PackageInstantiationDeclarationPrimaryUnit
| ContextDeclaration

// PslVerificationUnit -- add here if PSL is supported
SecondaryUnitPackageBody =
  PackageBody

SecondaryUnit =
  ArchitectureBody | SecondaryUnitPackageBody

//==============================================================================
// § 9: Expression
//==============================================================================
Literal =
  '#bit_string_literal'
| '#character_literal'
| '#string_literal'
| '#abstract_literal'
| 'null'

ParenthesizedExpressionOrAggregate =
  '(' ElementAssociation* ','* ')'

UnaryOperator =
  '??'
| '+'
| '-'
| 'abs'
| 'not'
| 'and'
| 'or'
| 'nand'
| 'nor'
| 'xor'
| 'xnor'

UnaryExpression =
  op:UnaryOperator Expression

BinaryOperator =
  'and'
| 'or'
| 'nand'
| 'nor'
| 'xor'
| 'xnor'
| '='
| '/='
| '<'
| '<='
| '>'
| '>='
| '?='
| '?/='
| '?<='
| '?<'
| '?>'
| '?>='
| 'sll'
| 'srl'
| 'sla'
| 'sra'
| 'rol'
| 'ror'
| '+'
| '-'
| '&'
| '*'
| '/'
| 'mod'
| 'rem'
| '**'
  // `to`/`downto` are folded into `BinaryOperator` so an `a to b` range
  // parses as a `BinaryExpression`, removing the need for a separate `range`
  // production.
| 'to'
| 'downto'

BinaryExpression =
  lhs:Expression op:BinaryOperator rhs:Expression

LiteralExpression =
  Literal

PhysicalLiteralExpression =
  PhysicalLiteral

NameExpression =
  Name

QualifiedExpression =
  Name '\'' ParenthesizedExpressionOrAggregate

Expression =
  LiteralExpression
| PhysicalLiteralExpression
| UnaryExpression
| BinaryExpression
| ParenthesizedExpressionOrAggregate
| Allocator
| NameExpression
| QualifiedExpression

Aggregate =
  '(' ElementAssociation* ','* ')'

// LRM has `new subtype_indication | new qualified_expression`. Additionally:
// "A subtype indication that is part of an allocator shall not include a resolution indication" (LRM 9.3.7)
// Applying unification yields: `allocator ::= name`:
// LRM: `allocator ::= new subtype_indication | new qualified_expression`.
// Both forms are subsumed by `Expression` (subtype_indication is reached as
// `NameExpression` with optional constraints on the underlying `Name`);
// analysis sorts the two cases out later.
Allocator =
  'new' Expression

OthersChoice =
  'others'

ExpressionChoice =
  Expression

Choice =
  ExpressionChoice | OthersChoice

Choices =
  Choice* '|'*

ElementAssociation =
  element_choices:(Choices '=>')?
  Expression

//==============================================================================
// § 8: Names
//==============================================================================
AbsolutePathname =
  '.' PartialPathname

// `(expression)` after the attribute designator becomes a separate
// `ParenthesizedName` tail on the enclosing `Name`. The signature brackets
// are also a name tail position; analysis associates them with this attribute.
AttributeName =
  Signature? '\'' attribute_designator_token:AttributeDesignator

// `range` and `subtype` are reserved words yet are valid attribute designators.
AttributeDesignator =
  '#identifier' | 'range' | 'subtype'

ExternalName =
  ExternalConstantName | ExternalSignalName | ExternalVariableName

ExternalConstantName =
  '<<' 'constant' ExternalPathname ':' SubtypeIndication '>>'

ExternalSignalName =
  '<<' 'signal' ExternalPathname ':' SubtypeIndication '>>'

ExternalVariableName =
  '<<' 'variable' ExternalPathname ':' SubtypeIndication '>>'

ExternalPathname =
  PackagePathname | AbsolutePathname | RelativePathname

PackagePathname =
  '@' '.'* simple_name:'#identifier'*

RelativePathname =
  '^'* '.'* PartialPathname?

PartialPathname =
  '#identifier'* '.'*

NameList =
  Name* ','*

Label =
  '#identifier' ':'

Designator =
  '#identifier' | '#string_literal'

NameDesignator =
  '#identifier' | '#string_literal' | '#character_literal'

Name =
  NamePrefix
  NameTail*
  // `RangeConstraint` appears here so the constraint of a `subtype_indication`
  // (e.g. `integer range 1 to 10`) parses as a `Name` followed by a tail —
  // see the comment on `SubtypeIndication`.
  RangeConstraint?

NameDesignatorPrefix =
  NameDesignator

NamePrefix =
  ExternalName | NameDesignatorPrefix

Suffix =
  '#identifier' | '#string_literal' | '#character_literal' | 'all'

SelectedName =
  '.' Suffix

// Indexed names, slice names, function calls, type conversions, and the
// `group_constituent_list` of a group declaration all collapse to this
// parenthesized association list. Analysis decides which one it is.
ParenthesizedName =
  '(' AssociationList? ')'

NameTail =
  SelectedName | ParenthesizedName | AttributeName

//==============================================================================
// § 12: Scope and Visibility
//==============================================================================
UseClause =
  'use' NameList? ';'

//==============================================================================
// § 10: Sequential Statements
//==============================================================================
Assertion =
  'assert'
  Expression
  report_clause:('report' Expression)?
  severity_clause:('severity' Expression)?

AssertionStatement =
  Label? Assertion ';'

CaseStatementAlternative =
  case_statement_alternative_preamble:('when' Choices? '=>')
  SequentialStatements?

CaseStatement =
  case_statement_preamble:(Label? 'case' '?'? Expression 'is')
  CaseStatementAlternative*
  case_statement_epilogue:('end' 'case' '?'? '#identifier'? ';')

ConditionClause =
  'until' Expression

ConditionalExpressions =
  conditional_expression:(Expression 'when' condition:Expression)
  conditional_else_when_expression:('else' Expression 'when' condition:Expression)*
  conditional_else_item:('else' Expression)?

ConditionalForceAssignment =
  Label? Target '<=' 'force' ForceMode? ConditionalExpressions ';'

ConditionalSignalAssignment =
  ConditionalWaveformAssignment | ConditionalForceAssignment

ConditionalVariableAssignment =
  Target ':=' ConditionalExpressions ';'

ConditionalWaveformAssignment =
  Target '<=' DelayMechanism? ConditionalWaveforms ';'

ConditionalWaveforms =
  conditional_waveform:(Waveform 'when' Expression)
  conditional_waveform_else_when_expression:('else' Waveform 'when' condition:Expression)*
  conditional_waveform_else_item:('else' Waveform)?

TransportDelayMechanism =
  'transport'

InertialDelayMechanism =
  'reject'? Expression? 'inertial'

DelayMechanism =
  TransportDelayMechanism | InertialDelayMechanism

ExitStatement =
  Label? 'exit' loop_label:'#identifier'? 'when'? Expression? ';'

ForceMode =
  'in' | 'out'

IfStatement =
  if_statement_preamble:(Label? 'if' Expression 'then')
  SequentialStatements?
  if_statement_elsif:('elsif' Expression 'then' SequentialStatements?)*
  if_statement_else:('else' SequentialStatements?)?
  if_statement_epilogue:('end' 'if' '#identifier'? ';')

WhileIterationScheme =
  'while' Expression

ForIterationScheme =
  'for' ParameterSpecification

IterationScheme =
  WhileIterationScheme | ForIterationScheme

LoopStatement =
  loop_statement_preamble:(Label? IterationScheme? 'loop')
  SequentialStatements?
  loop_statement_epilogue:('end' 'loop' '#identifier'? ';')

NextStatement =
  Label? 'next' loop_label:'#identifier'? 'when'? Expression? ';'

NullStatement =
  Label? 'null' ';'

ParameterSpecification =
  '#identifier' 'in' Expression

ProcedureCallStatement =
  Label? Name ';'

ReportStatement =
  Label? 'report' report:Expression 'severity'? severity:Expression? ';'

ReturnStatement =
  Label? 'return' Expression? ';'

SelectedExpressions =
  selected_expression_item:(Expression 'when' Choices?)* ','*

SelectedForceAssignment =
  Label?
  selected_assignment_preamble:('with' Expression 'select' '?'?)
  Target
  '<='
  'force'
  ForceMode?
  SelectedExpressions?
  ';'

SelectedWaveforms =
  selected_waveform_item:(Waveform 'when' Choices?)* ','*

SelectedSignalAssignment =
  SelectedWaveformAssignment | SelectedForceAssignment

SelectedVariableAssignment =
  Label?
  selected_assignment_preamble:('with' Expression 'select' '?'?)
  Target
  ':='
  SelectedExpressions?
  ';'

SelectedWaveformAssignment =
  Label?
  selected_assignment_preamble:('with' Expression 'select' '?'?)
  Target
  '<='
  DelayMechanism?
  SelectedWaveforms?
  ';'

SensitivityClause =
  'on' NameList?

SequentialStatement =
  WaitStatement
| AssertionStatement
| ReportStatement
| SignalAssignmentStatement
| VariableAssignmentStatement
| ProcedureCallStatement
| IfStatement
| CaseStatement
| LoopStatement
| NextStatement
| ExitStatement
| ReturnStatement
| NullStatement

SignalAssignmentStatement =
  SimpleSignalAssignment
| ConditionalSignalAssignment
| SelectedSignalAssignment

SimpleForceAssignment =
  Label? Target '<=' 'force' ForceMode? Expression ';'

SimpleReleaseAssignment =
  Label? Target '<=' 'release' ForceMode? ';'

SimpleWaveformAssignment =
  Label? Target '<=' DelayMechanism? Waveform ';'

SimpleSignalAssignment =
  SimpleWaveformAssignment | SimpleForceAssignment | SimpleReleaseAssignment

SimpleVariableAssignment =
  Label? Target ':=' Expression ';'

NameTarget =
  Name

AggregateTarget =
  Aggregate

Target =
  NameTarget | AggregateTarget

TimeoutClause =
  'for' Expression

VariableAssignmentStatement =
  SimpleVariableAssignment
| ConditionalVariableAssignment
| SelectedVariableAssignment

WaitStatement =
  Label? 'wait' SensitivityClause? ConditionClause? TimeoutClause? ';'

WaveformElement =
  Expression 'after'? time_expression:Expression?

WaveformElements =
  WaveformElement* ','*

UnaffectedWaveform =
  'unaffected'

Waveform =
  WaveformElements | UnaffectedWaveform

SequentialStatements =
  SequentialStatement*

//==============================================================================
// § 7: Specification
//==============================================================================
AttributeSpecification =
  'attribute'
  attribute_designator_token:'#identifier'
  'of'
  EntitySpecification
  'is'
  Expression
  ';'

BindingIndication =
  binding_use_clause:('use' EntityAspect)? GenericMapAspect? PortMapAspect?

ComponentSpecification =
  InstantiationList ':' Name

CompoundConfigurationSpecification =
  component_configuration_preamble:('for' ComponentSpecification)
  compound_configuration_specification_items:(
    binding:(BindingIndication ';')
    verification_unit_binding:(VerificationUnitBindingIndication ';')*
  )
  component_configuration_epilogue:('end' 'for' ';')

ConfigurationSpecification =
  SimpleConfigurationSpecification | CompoundConfigurationSpecification

DisconnectionSpecification =
  'disconnect' GuardedSignalSpecification 'after' Expression ';'

EntityEntityAspect =
  'entity' Name

EntityConfigurationAspect =
  'configuration' Name

EntityOpenAspect =
  'open'

EntityAspect =
  EntityEntityAspect | EntityConfigurationAspect | EntityOpenAspect

EntityClass =
  'entity'
| 'architecture'
| 'configuration'
| 'procedure'
| 'function'
| 'package'
| 'type'
| 'subtype'
| 'constant'
| 'signal'
| 'variable'
| 'component'
| 'label'
| 'literal'
| 'units'
| 'group'
| 'file'
| 'property'
| 'sequence'

EntityDesignator =
  EntityTag Signature?

EntityDesignatorList =
  EntityDesignator* ','*

EntityNameListAll =
  'all'

EntityNameListOthers =
  'others'

EntityNameList =
  EntityDesignatorList | EntityNameListAll | EntityNameListOthers

EntitySpecification =
  EntityNameList ':' EntityClass

EntityTag =
  '#identifier' | '#character_literal' | '#string_literal'

GuardedSignalSpecification =
  SignalList ':' Name

InstantiationListList =
  '#identifier'* ','*

InstantiationListAll =
  'all'

InstantiationListOthers =
  'others'

InstantiationList =
  InstantiationListList | InstantiationListAll | InstantiationListOthers

SignalListList =
  Name* ','*

SignalListAll =
  'all'

SignalListOthers =
  'others'

SignalList =
  SignalListList | SignalListAll | SignalListOthers

SimpleConfigurationSpecification =
  component_configuration_preamble:('for' ComponentSpecification)
  BindingIndication
  ';'
  component_configuration_epilogue:('end' 'for' ';')?

VerificationUnitBindingIndication =
  'use' 'vunit' VerificationUnitList

VerificationUnitList =
  Name* ','*

//==============================================================================
// § 4: Subprograms and packages
//==============================================================================
SubprogramDeclaration =
  SubprogramSpecification ';'

SubprogramSpecification =
  ProcedureSpecification | FunctionSpecification

ProcedureSpecification =
  'procedure'
  Designator
  SubprogramHeader
  parameter_list:('parameter'? parenthesized_interface_list:('(' InterfaceList ')'))?

FunctionSpecification =
  purity:('pure' | 'impure')?
  'function'
  Designator
  SubprogramHeader
  parameter_list:('parameter'? parenthesized_interface_list:('(' InterfaceList ')'))?
  'return'
  Name

SubprogramHeader =
  subprogram_header_generic_clause:('generic' '(' InterfaceList? ')')?
  GenericMapAspect?

SubprogramBody =
  subprogram_body_preamble:(SubprogramSpecification 'is')
  Declarations
  DeclarationStatementSeparator
  SequentialStatements
  subprogram_body_epilogue:('end' SubprogramKind? Designator? ';')

SubprogramKind =
  'procedure' | 'function'

SubprogramInstantiationDeclaration =
  subprogram_instantiation_declaration_preamble:(SubprogramKind name:'#identifier' 'is' 'new' Name Signature?)
  GenericMapAspect?
  ';'

Package =
  package_preamble:('package' name:'#identifier' 'is')
  PackageHeader
  Declarations
  package_epilogue:('end' 'package'? '#identifier'? ';')

PackageHeader =
  GenericClause? GenericMapAspect? ';'?

PackageBody =
  package_body_preamble:('package' 'body' name:'#identifier' 'is')
  Declarations
  package_body_epilogue:('end' 'package'? 'body'? '#identifier'? ';')

PackageInstantiation =
  package_instantiation_preamble:('package' name:'#identifier' 'is' 'new' Name)
  GenericMapAspect?
  ';'

Signature =
  '[' NameList? return_type:('return' Name)? ']'

//==============================================================================
// § 5: Types
//==============================================================================
AccessTypeDefinition =
  'access' SubtypeIndication

ArrayTypeDefinition =
  UnboundedArrayDefinition | ConstrainedArrayDefinition

CompositeTypeDefinition =
  ArrayTypeDefinition | RecordTypeDefinition

ConstrainedArrayDefinition =
  'array' IndexConstraint 'of' SubtypeIndication

// DiscreteRange
// LRM 5.3.2.1: "If a subtype indication appears as a discrete range, the subtype indication shall not contain a resolution indication."
// Without a resolution indication, discrete_range collapses into a simple `expression`:
//
// discrete_range ::= discrete_subtype_indication | range
//
// - discrete_subtype_indication ::= type_mark [ constraint ]
//   * type_mark is the same as a name
//   * As part of the broadening strategy, name absorbs constraint (due to ambiguity)
// - range ::= range_attribute_name | simple_expression direction simple_expression
//   * As part of the broadening strategy, the second form (expression direction expression) is absorbed into expression
ElementDeclaration =
  IdentifierList ':' SubtypeIndication ';'

EnumerationLiteral =
  '#identifier' | '#character_literal'

EnumerationTypeDefinition =
  '(' EnumerationLiteral* ','* ')'

FileTypeDefinition =
  'file' 'of' Name

IdentifierList =
  '#identifier'* ','*

IncompleteTypeDeclaration =
  'type' '#identifier' ';'

IndexSubtypeDefinition =
  Name 'range' '<>'

PhysicalLiteral =
  '#abstract_literal'? Name

PhysicalTypeDefinition =
  RangeConstraint
  unit_declarations:('units' PrimaryUnitDeclaration SecondaryUnitDeclaration*)
  physical_type_definition_epilogue:('end' 'units' name:'#identifier'?)

PrimaryUnitDeclaration =
  '#identifier' ';'

ProtectedTypeBody =
  protected_type_body_preamble:('protected' 'body')
  Declarations
  protected_type_body_epilogue:('end' 'protected' 'body' name:'#identifier'?)

ProtectedTypeDeclaration =
  ProtectedPreamble
  Declarations
  protected_type_declaration_epilogue:('end' 'protected' name:'#identifier'?)

ProtectedPreamble =
  'protected'

ProtectedTypeDefinition =
  ProtectedTypeDeclaration | ProtectedTypeBody

// `to`/`downto` are now `BinaryOperator`s, so an `a to b` range parses as a
// `BinaryExpression`. `range_constraint` therefore takes a plain expression.
RangeConstraint =
  'range' Expression

RecordTypeDefinition =
  RecordTypeDefinitionPreamble
  RecordElementDeclarations
  record_type_definition_epilogue:('end' 'record' '#identifier'?)

RecordElementDeclarations =
  ElementDeclaration*

RecordTypeDefinitionPreamble =
  'record'

NumericTypeDefinition =
  RangeConstraint

ScalarTypeDefinition =
  EnumerationTypeDefinition | NumericTypeDefinition | PhysicalTypeDefinition

SecondaryUnitDeclaration =
  '#identifier' '=' PhysicalLiteral ';'

IndexConstraint =
  '(' Expression* ','* ')'

UnboundedArrayDefinition =
  'array'
  '('
  index_subtype_definition_list:(IndexSubtypeDefinition* ','*)?
  ')'
  'of'
  SubtypeIndication
